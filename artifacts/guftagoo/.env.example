# Copy this file to .env (same folder) and fill in your Supabase project's
# values from Supabase → Project Settings → API. These are safe to expose
# in the browser. Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
